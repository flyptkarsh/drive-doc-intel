# Postgres connection string
DATABASE_URL=postgres://localhost/drive_doc_intel_dev

# Google OAuth "Web application" client (the Lounge Frog Workspace client works).
# Add your app origin (e.g. http://localhost:3000 and the Render URL) to the
# client's Authorized JavaScript origins, and enable the Google Drive API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude API key used for extraction and Q&A
ANTHROPIC_API_KEY=

# Random strings: `openssl rand -base64 32`
SESSION_SECRET=
# Optional, encrypts stored Drive refresh tokens (defaults to SESSION_SECRET)
ENCRYPTION_KEY=

# Optional: comma-separated emails and/or @domains allowed to sign in
ALLOWED_SIGNINS=

# Optional: secret for POST /api/cron/sync (Authorization: Bearer <secret>)
CRON_SECRET=
# Optional: seconds between background Drive polls (default 60)
SYNC_INTERVAL_SECONDS=60
# Optional: model override (default claude-opus-5-5)
CLAUDE_MODEL=
