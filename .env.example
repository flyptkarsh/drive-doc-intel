# Copy to .env.local and fill in. README → "API keys and secrets" explains each value.

# ---- Required ---------------------------------------------------------------

# Postgres connection string (`createdb drive_doc_intel_dev`)
DATABASE_URL=postgres://localhost/drive_doc_intel_dev

# Google OAuth "Web application" client, from Google Cloud Console → APIs & Services
# → Credentials. Add http://localhost:3000 to its Authorized JavaScript origins,
# enable the Google Drive API, and add the drive.readonly scope to the consent screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude API key from console.anthropic.com → API Keys (used for extraction and Ask)
ANTHROPIC_API_KEY=

# Random string that signs session cookies: `openssl rand -base64 32`
SESSION_SECRET=

# ---- Optional ---------------------------------------------------------------

# Encrypts stored Drive refresh tokens (defaults to SESSION_SECRET)
ENCRYPTION_KEY=
# Comma-separated emails and/or @domains allowed to sign in (empty = anyone)
ALLOWED_SIGNINS=
# Enables POST /api/cron/sync with `Authorization: Bearer <secret>`
CRON_SECRET=
# Seconds between background Drive polls (default 60)
SYNC_INTERVAL_SECONDS=60
# Model override, e.g. claude-sonnet-5-5 while developing (default claude-opus-5-5)
CLAUDE_MODEL=
# Set to 1 to turn off background sync
DISABLE_POLLER=
